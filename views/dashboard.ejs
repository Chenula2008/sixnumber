<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Six Number</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Montag Ad Code -->
    <!-- <script src="https://quge5.com/88/tag.min.js" data-zone="254010" async data-cfasync="false"></script> -->

    <!-- Adsterra Ad Code -->
    <script src="https://pl30672642.effectivecpmnetwork.com/3f/8f/42/3f8f42b3760fc0fad9fc1064f5e3e3d4.js"></script>
    <!-- <script async="async" data-cfasync="false" src="https://pl30672643.effectivecpmnetwork.com/8bea917f56175f93390c546a9e07224a/invoke.js"></script> -->
    <!-- <div id="container-8bea917f56175f93390c546a9e07224a"></div> -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <style>
        /* === RESET & BASE === */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1040 50%, #0d1b3e 100%);
            min-height: 100vh;
            color: #ffffff;
            overflow-x: hidden;
        }
        body::before {
            content: ''; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: radial-gradient(circle at 20% 80%, rgba(120, 80, 255, 0.08) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, rgba(0, 200, 255, 0.08) 0%, transparent 50%),
                        radial-gradient(circle at 50% 50%, rgba(255, 100, 200, 0.05) 0%, transparent 50%);
            pointer-events: none; z-index: 0;
        }

        /* === TOP NAVIGATION === */
        .navbar {
            position: sticky; top: 0; z-index: 100;
            background: rgba(10, 14, 39, 0.85); backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 0 30px; height: 70px; display: flex; align-items: center; justify-content: space-between;
        }
        .nav-brand {
            font-size: 24px; font-weight: 900; letter-spacing: -0.5px;
            display: flex; align-items: center; gap: 8px; text-decoration: none; color: white;
        }
        .nav-brand span:first-child { color: #ffffff; }
        .nav-brand span:nth-child(2) { 
            background: linear-gradient(135deg, #00d4ff, #7c3aed);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .nav-brand .flag { font-size: 20px; margin-left: 2px; animation: subtle-wave 3s ease-in-out infinite; }
        @keyframes subtle-wave { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(3deg); } 75% { transform: rotate(-3deg); } }

        .nav-balance {
            display: flex; align-items: center; gap: 12px;
            background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 10px 20px; border-radius: 50px;
        }
        .balance-icon {
            width: 36px; height: 36px; background: linear-gradient(135deg, #10b981, #059669);
            border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px;
        }
        .balance-info { display: flex; flex-direction: column; }
        .balance-label { font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 1px; }
        .balance-amount { font-size: 20px; font-weight: 800; color: #10b981; }

        .nav-actions { display: flex; gap: 10px; align-items: center; }
        .nav-btn {
            padding: 10px 18px; border-radius: 10px; text-decoration: none; font-size: 13px; font-weight: 600;
            transition: all 0.3s ease; border: 1px solid transparent; display: flex; align-items: center; gap: 6px;
        }
        .nav-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.3); }
        .btn-withdraw { background: linear-gradient(135deg, #3b82f6, #2563eb); color: white; }
        .btn-history { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; }
        .btn-admin { background: linear-gradient(135deg, #06b6d4, #0891b2); color: white; }
        .btn-logout { background: rgba(239, 68, 68, 0.15); color: #f87171; border-color: rgba(239, 68, 68, 0.3); }
        .btn-logout:hover { background: rgba(239, 68, 68, 0.25); }

        /* === MAIN CONTENT === */
        .main-content {
            position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center;
            justify-content: flex-start; min-height: calc(100vh - 70px); padding: 40px 20px;
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(124, 58, 237, 0.15); border: 1px solid rgba(124, 58, 237, 0.3);
            padding: 8px 18px; border-radius: 50px; font-size: 13px; color: #a78bfa; margin-bottom: 20px;
        }
        .hero-title { font-size: 42px; font-weight: 900; text-align: center; margin-bottom: 10px; line-height: 1.1; }
        .hero-title .gradient-text {
            background: linear-gradient(135deg, #00d4ff, #7c3aed, #f472b6);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .hero-subtitle { font-size: 16px; color: rgba(255, 255, 255, 0.5); text-align: center; margin-bottom: 40px; }

        .earn-card {
            background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(40px);
            border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px;
            padding: 50px 40px; width: 100%; max-width: 480px; text-align: center;
            position: relative; overflow: hidden; animation: fadeInUp 0.6s ease;
        }
        .earn-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, #00d4ff, #7c3aed, #f472b6, #7c3aed, #00d4ff);
            background-size: 200% 100%; animation: shimmer 3s ease-in-out infinite;
        }
        @keyframes shimmer { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

        .card-label { font-size: 12px; text-transform: uppercase; letter-spacing: 3px; color: rgba(255, 255, 255, 0.4); margin-bottom: 15px; font-weight: 600; }
        .target-numbers {
            font-family: 'JetBrains Mono', monospace; font-size: 56px; font-weight: 700; letter-spacing: 12px;
            background: linear-gradient(135deg, #00d4ff, #60a5fa); -webkit-background-clip: text;
            -webkit-text-fill-color: transparent; margin-bottom: 30px; text-shadow: 0 0 40px rgba(0, 212, 255, 0.3); user-select: all;
        }
        .input-wrapper { position: relative; margin-bottom: 20px; }
        .number-input {
            width: 100%; padding: 18px 24px; font-size: 24px; font-family: 'JetBrains Mono', monospace;
            font-weight: 600; letter-spacing: 8px; text-align: center; background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.1); border-radius: 16px; color: #ffffff;
            outline: none; transition: all 0.3s ease;
        }
        .number-input::placeholder { color: rgba(255, 255, 255, 0.2); letter-spacing: 4px; font-size: 16px; }
        .number-input:focus { border-color: rgba(0, 212, 255, 0.5); box-shadow: 0 0 30px rgba(0, 212, 255, 0.1); background: rgba(255, 255, 255, 0.08); }

        .submit-btn {
            width: 100%; padding: 18px; font-size: 16px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
            background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 16px;
            cursor: pointer; transition: all 0.3s ease; position: relative; overflow: hidden;
        }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 40px rgba(16, 185, 129, 0.3); }
        .submit-btn:active { transform: translateY(0); }
        .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }

        .earn-info {
            display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 25px;
            padding: 12px 20px; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 12px;
        }
        .earn-info span { font-size: 14px; color: rgba(16, 185, 129, 0.8); font-weight: 500; }
        .earn-amount { font-weight: 800 !important; color: #10b981 !important; }

        .stats-row {
            display: flex; gap: 15px; width: 100%; max-width: 480px; margin-top: 30px; animation: fadeInUp 0.8s ease;
        }
        .stat-card {
            flex: 1; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px; padding: 20px; text-align: center;
        }
        .stat-card .stat-icon { font-size: 24px; margin-bottom: 8px; }
        .stat-card .stat-value { font-size: 22px; font-weight: 800; color: #ffffff; }
        .stat-card .stat-label { font-size: 11px; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }

        .footer { position: relative; z-index: 1; text-align: center; padding: 20px; color: rgba(255, 255, 255, 0.336); font-size: 12px; }

        @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

        /* === FLOATING SUPPORT BUTTON === */
        .floating-support-btn {
            position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px;
            background: linear-gradient(135deg, #00d4ff, #7c3aed); color: white; border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 28px; text-decoration: none;
            box-shadow: 0 8px 25px rgba(124, 58, 237, 0.5); z-index: 9999; transition: all 0.3s ease; animation: pulse-support 2s infinite;
        }
        .floating-support-btn:hover { transform: scale(1.1) rotate(10deg); box-shadow: 0 12px 35px rgba(124, 58, 237, 0.7); }
        .support-tooltip {
            position: absolute; right: 75px; background: rgba(15, 23, 42, 0.9); color: #fff; padding: 8px 12px;
            border-radius: 8px; font-size: 13px; font-weight: 600; white-space: nowrap; opacity: 0; pointer-events: none;
            transition: all 0.3s ease; transform: translateX(10px); border: 1px solid rgba(255,255,255,0.1);
        }
        .floating-support-btn:hover .support-tooltip { opacity: 1; transform: translateX(0); }
        @keyframes pulse-support {
            0% { box-shadow: 0 0 0 0 rgba(124, 58, 237, 0.6); }
            70% { box-shadow: 0 0 0 15px rgba(124, 58, 237, 0); }
            100% { box-shadow: 0 0 0 0 rgba(124, 58, 237, 0); }
        }

        @media (max-width: 768px) {
            .navbar { padding: 0 15px; height: auto; padding: 15px; flex-wrap: wrap; gap: 10px; }
            .nav-balance { padding: 8px 14px; }
            .balance-amount { font-size: 16px; }
            .nav-actions { flex-wrap: wrap; justify-content: center; }
            .nav-btn { padding: 8px 12px; font-size: 12px; }
            .hero-title { font-size: 28px; }
            .target-numbers { font-size: 40px; letter-spacing: 8px; }
            .earn-card { padding: 30px 20px; }
            .stats-row { flex-direction: column; }
            .feedback-carousel-container { flex-direction: column !important; gap: 15px !important; }
            .feedback-carousel-container button { width: 100% !important; height: 40px !important; border-radius: 8px !important; }
        }

        /* Hide top-right social bar ad on mobile screens to prevent overlap */
        @media (max-width: 768px) {
            #social-bar-ad {
                display: flex;
            }
        }
    </style>
</head>
<body>

    <!-- === TOP NAVIGATION === -->
    <nav class="navbar">
        <a href="/dashboard" class="nav-brand" onclick="window.open('https://omg10.com/4/11208116', '_blank');">
            <span>Six</span>
            <span>Number</span>
            <span class="flag">🇱🇰</span>
        </a>

        <div class="nav-balance">
            <div class="balance-icon">💰</div>
            <div class="balance-info">
                <span class="balance-label">Balance</span>
                <span class="balance-amount">$<span id="balance"><%= (user.walletCents / 100).toFixed(3) %></span></span>
            </div>
        </div>

        <div class="nav-actions">
            <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                <a href="/withdraw" class="nav-btn btn-withdraw" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">💸 Withdrawal</a>
                <a href="/history" class="nav-btn btn-history" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">📋 History</a>
                <a href="/daily-tasks" class="nav-btn" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border: none;" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">📅 Daily Tasks</a>
                <a href="/profile" class="nav-btn btn-profile" style="background: #f472b6; color: #ffffff; border: 1px solid rgba(236, 72, 153, 0.2);" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">👤 Profile</a>
                <a href="/feedback" class="nav-btn" style="background: rgba(251, 191, 36, 0.15); color: #fbbf24; border-color: rgba(251, 191, 36, 0.3);" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">💬 Feedback</a>
                
                <% if (user.isAdmin || user.role === 'admin' || user.username === 'admin') { %>
                    <a href="/admin" class="nav-btn btn-admin">🛡️ Admin</a>
                <% } %>
                <a href="/logout" class="nav-btn btn-logout" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">Logout</a>
            <% } else { %>
                <a href="/login" class="nav-btn" style="background: linear-gradient(135deg, #3b82f6, #2563eb); color: white;" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">🔒 Login</a>
                <a href="/signup" class="nav-btn" style="background: linear-gradient(135deg, #10b981, #059669); color: white;" onclick="window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');">✨ Sign Up</a>
            <% } %>
        </div>
    </nav>

    <!-- === MAIN CONTENT === -->
    <div class="main-content">

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
        <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 16px; margin-bottom: 25px; text-align: center; border: 1px solid rgba(255,255,255,0.08); width: 100%; max-width: 480px;">
            <p style="font-size: 13px; color: #94a3b8; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Daily Typing Limit</p>
            <p id="remainingText" style="font-size: 28px; font-weight: 800; color: <%= remainingEntries > 0 ? '#10b981' : '#ef4444' %>; margin: 0;">
                <%= remainingEntries %> <span style="font-size: 16px; color: #94a3b8; font-weight: 500;">/ 170 entries left today</span>
            </p>
            <div style="width: 100%; height: 10px; background: rgba(0,0,0,0.3); border-radius: 5px; margin-top: 15px; overflow: hidden;">
                <div id="limitProgressBar" style="width: <%= ((170 - remainingEntries) / 170) * 100 %>%; height: 100%; background: linear-gradient(90deg, #10b981, #00d4ff); transition: width 0.5s ease; border-radius: 5px;"></div>
            </div>
        </div>
        <% } %>

        <div class="hero-badge">⚡ Earn Money by Typing Numbers</div>
        <h1 class="hero-title">Welcome to <span class="gradient-text">Six Number</span></h1>
        <p class="hero-subtitle">Type the numbers below correctly to earn rewards instantly</p>

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
            <div class="earn-card">
                <div class="card-label">Type These Numbers</div>
                <div class="target-numbers" id="targetNumbers"><%= user.currentNumbers %></div>
                
                <div class="input-wrapper">
                    <input type="text" id="numberInput" class="number-input" maxlength="6" inputmode="numeric" pattern="[0-9]*" placeholder="• • • • • •" autocomplete="off">
                </div>
                
                <button class="submit-btn" id="submitBtn" onclick="window.open('https://omg10.com/4/11208116', '_blank'); submitNumbers();">
                    ✨ Submit & Earn
                </button>

                <div class="earn-info">
                    <span>🎯 Earn</span>
                    <span class="earn-amount">$0.001</span>
                    <span>per correct submission</span>
                </div>
            </div>
        <% } else { %>
            <div class="earn-card" style="text-align: center; border: 2px dashed rgba(0, 212, 255, 0.3);">
                <div class="card-label" style="color: #00d4ff;">👀 Preview Mode</div>
                <div class="target-numbers" style="font-size: 48px; opacity: 0.6;"><%= user.currentNumbers %></div>
                
                <div class="input-wrapper">
                    <input type="text" id="guestNumberInput" class="number-input" maxlength="6" inputmode="numeric" pattern="[0-9]*" placeholder="• • • • • •" autocomplete="off">
                </div>
                
                <button class="submit-btn" id="guestSubmitBtn" onclick="promptGuestSignup(); window.open('https://www.effectivecpmnetwork.com/sk3igeakhw?key=d115a9f24e580272427a899a58fff791', '_blank');" style="background: linear-gradient(135deg, #00d4ff, #7c3aed);">
                    🔒 Login to Earn
                </button>

                <div class="earn-info" style="margin-top: 25px;">
                    <span>🎯 Earn</span>
                    <span class="earn-amount">$0.001</span>
                    <span>per correct submission</span>
                </div>
            </div>
        <% } %>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon">💵</div>
                <div class="stat-value">$<%= (user.walletCents / 100).toFixed(3) %></div>
                <div class="stat-label">Total Earned</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🔢</div>
                <div class="stat-value"><%= Math.round(user.walletCents * 10) %></div>
                <div class="stat-label">Submissions</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🏆</div>
                <div class="stat-value">$5.00</div>
                <div class="stat-label">Min. Withdraw</div>
            </div>
        </div>

        <!-- 🚀 CUSTOMER FEEDBACK SECTION (CAROUSEL WITH ARROWS) -->
        <div style="margin-top: 80px; padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.06); width: 100%; max-width: 800px;">
            <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 10px; color: #ffffff;">⭐ What Our Users Say</h2>
                <p style="color: rgba(255,255,255,0.5); font-size: 15px;">Real feedback from our growing community</p>
            </div>

            <div class="feedback-carousel-container" style="position: relative; display: flex; align-items: center; gap: 15px;">
                
                <!-- Left Arrow Button -->
                <button onclick="goToFeedback(currentFeedbackIndex - 1)" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; flex-shrink: 0; font-size: 20px;" onmouseover="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='scale(1.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'; this.style.transform='scale(1)'">
                    ←
                </button>

                <div style="flex: 1; width: 100%;">
                    <div id="feedback-display" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 30px; text-align: center; transition: all 0.3s ease; min-height: 250px; display: flex; align-items: center; justify-content: center;">
                        <!-- Content injected via JS -->
                    </div>
                    
                    <div style="display: flex; justify-content: center; gap: 8px; margin-top: 20px;" id="feedback-dots">
                        <!-- Dots injected via JS -->
                    </div>
                </div>

                <!-- Right Arrow Button -->
                <button onclick="goToFeedback(currentFeedbackIndex + 1)" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; flex-shrink: 0; font-size: 20px;" onmouseover="this.style.background='rgba(255,255,255,0.15)'; this.style.transform='scale(1.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'; this.style.transform='scale(1)'">
                    →
                </button>

            </div>
            
            <div style="text-align: center; margin-top: 30px;">
                <a href="/feedback" style="color: #00d4ff; text-decoration: none; font-weight: 600; font-size: 15px; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease;" onmouseover="this.style.gap='12px'" onmouseout="this.style.gap='8px'">
                    Read all reviews <span style="font-size: 18px;">→</span>
                </a>
            </div>
        </div>
    </div>

    <!-- === FOOTER === -->
    <div class="footer">
        <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 8px;">
            <span style="font-size: 16px;">🇱🇰</span>
            <span style="color: rgba(255, 255, 255, 0.5); font-size: 12px;">Made with ❤️ in Sri Lanka</span>
        </div>
        <p>© 2026 SixNumber. All rights reserved.</p>
    </div>

    <!-- 🚀 FLOATING SUPPORT BUTTON -->
    <a href="/contact" class="floating-support-btn" title="Contact Support">
        <span class="support-icon" onclick="window.open('https://omg10.com/4/11208116', '_blank');">💬</span>
        <span class="support-tooltip" onclick="window.open('https://omg10.com/4/11208116', '_blank');">Need Help?</span>
    </a>

    <!-- === JAVASCRIPT === -->
    <script>
        const numberInput = document.getElementById('numberInput');
        if (numberInput) {
            numberInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            numberInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    window.open('https://omg10.com/4/11208116', '_blank');
                    submitNumbers();
                }
            });
        }

        const guestInput = document.getElementById('guestNumberInput');
        if (guestInput) {
            guestInput.addEventListener('input', function(e) {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            guestInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') promptGuestSignup();
            });
        }

        function promptGuestSignup() {
            Swal.fire({
                icon: 'info', title: 'Join SixNumber to Earn!',
                html: 'Creating an account takes less than 10 seconds.<br>Start earning <strong style="color: #10b981;">$0.001</strong> per correct submission instantly!',
                background: '#1a1040', color: '#fff', showCancelButton: true,
                confirmButtonText: '✨ Create Free Account', cancelButtonText: '🔒 I have an account',
                confirmButtonColor: '#10b981', cancelButtonColor: '#3b82f6'
            }).then((result) => {
                if (result.isConfirmed) window.location.href = '/signup';
                else if (result.dismiss === 'cancel') window.location.href = '/login';
            });
        }

        async function submitNumbers() {
            const typedNumbers = document.getElementById('numberInput').value;
            const submitBtn = document.getElementById('submitBtn');

            if (!/^\d{6}$/.test(typedNumbers)) {
                return Swal.fire({ icon: 'error', title: 'Oops!', text: 'Please enter exactly 6 numbers.', background: '#1a1040', color: '#fff', confirmButtonColor: '#7c3aed' });
            }

            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ Verifying...';

            try {
                const response = await fetch('/api/earn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ typedNumbers })
                });

                const data = await response.json();

                if (data.success) {
                    if (data.remaining !== undefined) {
                        const remainingText = document.getElementById('remainingText');
                        if (remainingText) {
                            remainingText.style.color = data.remaining > 0 ? '#10b981' : '#ef4444';
                            remainingText.innerHTML = `${data.remaining} <span style="font-size: 16px; color: #94a3b8; font-weight: 500;">/ 170 entries left today</span>`;
                        }
                        const progressBar = document.getElementById('limitProgressBar');
                        if (progressBar) {
                            progressBar.style.width = `${((170 - data.remaining) / 170) * 100}%`;
                        }
                    }

                    document.getElementById('balance').innerText = data.newBalance;
                    document.getElementById('targetNumbers').innerText = data.newNumbers;
                    document.getElementById('numberInput').value = '';
                    document.querySelectorAll('.stat-value')[1].innerText = Math.round(parseFloat(data.newBalance) * 1000);

                    Swal.fire({
                        icon: 'success', title: '🎉 Correct!',
                        html: `<span style="font-size: 18px; color: #10b981; font-weight: bold;">+$${data.earned}</span><br><span style="color: #999; font-size: 14px;">added to your wallet</span>`,
                        background: '#1a1040', color: '#fff', confirmButtonColor: '#10b981', timer: 2000, showConfirmButton: false
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Incorrect!', text: data.error, background: '#1a1040', color: '#fff', confirmButtonColor: '#ef4444' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.', background: '#1a1040', color: '#fff', confirmButtonColor: '#ef4444' });
            }

            submitBtn.disabled = false;
            submitBtn.textContent = '✨ Submit & Earn';
        }

        // 🚀 FEEDBACK CAROUSEL LOGIC
        const feedbacksData = <%- JSON.stringify(recentFeedbacks || []) %>;
        let currentFeedbackIndex = 0;
        const isAdmin = <%= typeof isLoggedIn !== 'undefined' && isLoggedIn && (user.isAdmin || user.role === 'admin') ? 'true' : 'false' %>;

        function renderFeedback() {
            const display = document.getElementById('feedback-display');
            const dotsContainer = document.getElementById('feedback-dots');
            
            if (!feedbacksData || feedbacksData.length === 0) {
                display.innerHTML = `
                    <div style="padding: 40px;">
                        <p style="color: rgba(255,255,255,0.5); margin-bottom: 20px;">No feedback yet. Be the first to share your experience!</p>
                        <a href="/feedback" style="display: inline-block; padding: 10px 20px; background: linear-gradient(135deg, #ec4899, #be185d); color: white; text-decoration: none; border-radius: 8px; font-weight: 600;" onclick="window.open('https://omg10.com/4/11208116', '_blank');">Leave Feedback</a>
                    </div>
                `;
                return;
            }

            const fb = feedbacksData[currentFeedbackIndex];
            const stars = '★'.repeat(fb.rating) + '☆'.repeat(5 - fb.rating);
            const date = new Date(fb.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            
            const deleteBtn = isAdmin ? `
                <form action="/admin/feedback/${fb._id}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this feedback?');" style="margin-top: 15px;">
                    <button type="submit" style="background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.25)'" onmouseout="this.style.background='rgba(239, 68, 68, 0.1)'">
                        🗑️ Delete
                    </button>
                </form>
            ` : '';

            display.innerHTML = `
                <div style="display: flex; flex-direction: column; align-items: center; gap: 15px; width: 100%;">
                    <div style="width: 50px; height: 50px; background: linear-gradient(135deg, #00d4ff, #7c3aed); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; font-size: 20px; flex-shrink: 0;">
                        ${fb.name.charAt(0).toUpperCase()}
                    </div>
                    <div style="text-align: center;">
                        <div style="font-weight: 600; color: #fff; font-size: 16px;">${fb.name}</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; gap: 4px;">🌍 ${fb.country}</div>
                    </div>
                    <div style="color: #fbbf24; font-size: 18px; letter-spacing: 2px;">${stars}</div>
                    <div style="font-size: 15px; color: rgba(255,255,255,0.8); line-height: 1.6; font-style: italic; max-width: 500px; text-align: center;">
                        "${fb.message}"
                    </div>
                    <div style="font-size: 11px; color: rgba(255,255,255,0.3);">
                        ${date}
                    </div>
                    ${deleteBtn}
                </div>
            `;

            // Update dots
            dotsContainer.innerHTML = feedbacksData.map((_, index) => `
                <div style="width: ${index === currentFeedbackIndex ? '24px' : '8px'}; height: 8px; background: ${index === currentFeedbackIndex ? '#00d4ff' : 'rgba(255,255,255,0.2)'}; border-radius: 4px; transition: all 0.3s ease; cursor: pointer;" onclick="goToFeedback(${index})"></div>
            `).join('');
        }

        function goToFeedback(index) {
            if (!feedbacksData || feedbacksData.length === 0) return;
            currentFeedbackIndex = index;
            if (currentFeedbackIndex < 0) currentFeedbackIndex = feedbacksData.length - 1;
            if (currentFeedbackIndex >= feedbacksData.length) currentFeedbackIndex = 0;
            renderFeedback();
        }

        // Keyboard navigation (bonus)
        document.addEventListener('keydown', (e) => {
            if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
            if (e.key === 'ArrowLeft') goToFeedback(currentFeedbackIndex - 1);
            else if (e.key === 'ArrowRight') goToFeedback(currentFeedbackIndex + 1);
        });

        // Initial render
        if (document.getElementById('feedback-display')) {
            renderFeedback();
        }
    </script>

